# ─── Precedent ────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in.  .env.local is gitignored; this file is not.
# NEVER paste real values into chat, screenshots, or a commit.

# ── 1. Memory engine (the Python service) ────────────────────────────────────
# Where the engine is reachable: localhost in dev, your VPS URL in production.
ENGINE_URL=http://127.0.0.1:8787
# Any long random string; set the SAME value in the engine's own environment.
# Generate one:  openssl rand -hex 32
ENGINE_API_KEY=

# ── 2. Virtuals ACP ───────────────────────────────────────────────────────────
# All four come from your agent's page at https://app.virtuals.io/acp/agents/
# after you register at https://app.virtuals.io/acp/new  (see SETUP.md).
#
# The wallet address of the agent you registered.
ACP_AGENT_WALLET_ADDRESS=
# "Signers" tab on your agent's page.
ACP_WALLET_ID=
# "Signers" tab → "+ Add Signer" → "Copy Key". Platform-generated: it controls
# the AGENT wallet, not your personal one — but it is still a private key.
ACP_SIGNER_PRIVATE_KEY=
# OPTIONAL — leave blank, nothing depends on it.
# A Base builder code comes from BASE, not Virtuals: register at base.dev, then
# Settings -> Builder Code. (The ACP SDK README points at the agent's Settings
# tab on app.virtuals.io, which is where you link it, not where it is issued.)
# It is an attribution tag appended to transaction calldata; per Base's docs
# contracts "execute normally and ignore the extra data", so every job and
# payment works identically without one.
ACP_BUILDER_CODE=

# ── 3. Base ───────────────────────────────────────────────────────────────────
# Public RPC is fine for reads; swap in Alchemy/QuickNode if rate-limited.
BASE_RPC_URL=https://mainnet.base.org
# Burner key that pays gas to post the journal digest. Fund with a few dollars
# of ETH on Base. Use a wallet created for this project and nothing else.
PRECEDENT_WALLET_PRIVATE_KEY=
